<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-only
  Copyright (C) 2026 Stefan Gangefors

  Nothing leaves the phone through backup or device transfer: the rider's
  sections, tracks and locations stay on the device unless the rider exports
  them (CLAUDE.md, Security). android:allowBackup="false" covers Android 11
  and lower; these rules cover Android 12 and higher, where allowBackup does
  not stop device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
