    <string name="help_map_title">The map</string>
    <string name="help_map">Tap a road to see what it is, or a section to open its card. The buttons on the map:</string>
    <string name="help_plan_title">Plan a ride</string>
    <string name="help_plan">Long-press a place to start there, then long-press where you want to go. The place’s card can also route or loop from where you are, and a route or loop can be shared or saved:</string>
    <string name="help_sections_title">Favourite roads</string>
    <string name="help_sections">Tap where a road you like starts and where it ends, then rate it good, great or epic: routes and loops lean towards your sections. Pick one in Sections to see it, then loop through it or route through it from where you are.</string>
    <string name="help_ride_title">On a ride</string>
    <string name="help_library_title">Routes and rides</string>
    <string name="help_ride">Record your ride, and tag roads you like as you pass them. After the ride, review each tagged spot: it may be a road you want to save as a section.</string>
    <string name="help_settings_title">Ride settings</string>
    <string name="help_settings">The gear on the map opens them, in three groups:</string>
    <!-- The keys of the how-to page: a button's name, then what it does. -->
    <string name="help_see">see %1$s</string>
    <string name="help_key_menu">Menu</string>
    <string name="help_key_menu_what">routes and rides, sections, map regions (the countries on the phone, each switched on or off; those on are one map, joined at the borders), this page, About; the sun or moon at its top switches light and dark</string>
    <string name="help_key_review">Review</string>
    <string name="help_key_review_map">shown when tagged spots wait</string>
    <string name="help_key_review_what">how many tagged spots wait; tap to go through them</string>
    <string name="help_key_tag">TAG</string>
    <string name="help_key_tag_what">saves the spot you are on</string>
    <string name="help_key_settings">Ride settings</string>
    <string name="help_key_settings_what">gravel, loop length, zooms, screen</string>
    <string name="help_key_loop">Loop</string>
    <string name="help_key_loop_what">plans loops from where you are</string>
    <string name="help_key_mark">Mark section</string>
    <string name="help_key_mark_map">saves a road you like</string>
    <string name="help_key_mark_what">starts marking a road</string>
    <string name="help_key_record">Record</string>
    <string name="help_key_record_map">records your ride</string>
    <string name="help_key_record_what">records your ride; tap the stop square to end it</string>
    <string name="help_key_location">Location button</string>
    <string name="help_key_location_what">centres the map on you and follows you</string>
    <string name="help_key_route_here">Route from my position</string>
    <string name="help_key_route_here_what">from your position to the place</string>
    <string name="help_key_loop_here">Loop from here</string>
    <string name="help_key_loop_here_what">loops from the place</string>
    <string name="help_key_share">Share</string>
    <string name="help_key_share_what">to your nav app, as GPX</string>
    <string name="help_key_save">Save</string>
    <string name="help_key_save_what">keeps it under Routes &amp; rides in the menu</string>
    <string name="help_key_sections">Sections</string>
    <string name="help_key_sections_what">in the menu: all your sections</string>
