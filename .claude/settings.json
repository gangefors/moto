{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "git config core.hooksPath .githooks" },
          { "type": "command", "command": "if [ \"$(git rev-parse --is-shallow-repository 2>/dev/null)\" = true ]; then git fetch --unshallow --quiet >/dev/null 2>&1 || true; fi; exit 0", "timeout": 120 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__add_issue_comment",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-text.sh" }
        ]
      }
    ]
  }
}
