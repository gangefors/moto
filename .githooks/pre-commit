# CLAUDE.md commit rules: rule changes (CLAUDE.md, ADRs) and application
# code (android/, core/, .github/) go in separate commits; every new
# source file starts with the SPDX header.
set -u
fail() { echo "pre-commit: $1" >&2; exit 1; }

# NUL-separated and without rename detection, so every old and new path
# is listed and odd file names are not quoted.
rules=$(git diff --cached --name-only -z --no-renames --diff-filter=ACMRD \
  | { grep -zE '^(CLAUDE\.md|docs/adr/)' || true; } | tr '\0' '\n')
code=$(git diff --cached --name-only -z --no-renames --diff-filter=ACMRD \
  | { grep -zE '^(android|core|\.github)/' || true; } | tr '\0' '\n')
if [ -n "$rules" ] && [ -n "$code" ]; then
  fail "rule changes and application code go in separate commits; staged together: $(echo "$rules" | head -2 | tr '\n' ' ')with $(echo "$code" | head -2 | tr '\n' ' ')"
fi

git diff --cached --name-only -z --diff-filter=A \
  | { grep -zE '\.(rs|kt|kts|py|sh)$' || true; } \
  | while IFS= read -r -d '' f; do
    git show ":$f" | head -5 | grep -q 'SPDX-License-Identifier: AGPL-3.0-only' \
      || fail "$f: missing the SPDX licence header"
  done || exit 1
